# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The LinkedIn Client ID/Secret do NOT go here — paste them into
# Supabase → Authentication → Providers → LinkedIn (OIDC).

# Optional — Web Push when the app is closed (see README)
VITE_VAPID_PUBLIC_KEY=
